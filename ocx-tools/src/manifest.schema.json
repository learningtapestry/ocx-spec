{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "OCX Manifest",
  "type": "object",
  "properties": {
    "@id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inLanguage": {
      "type": "string",
      "enum": ["en-US", "es-US"]
    },
    "format": {
      "type": "string",
      "pattern": "^ocx@\\d+\\.\\d+\\.\\d+$"
    },
    "contents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": [
              "Course",
              "LessonGrouping",
              "Lesson",
              "Activity",
              "Assessment",
              "Material",
              "ClassroomMaterial",
              "GlossaryTerm",
              "InstructionalRoutine",
              "StandardsFramework",
              "StandardsFrameworkItem",
              "Representation"
            ]
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["@id", "format", "contents"],
  "additionalProperties": false
}
