{
  "name": "@learningtapestry/ocx-tools",
  "version": "1.0.0",
  "description": "TypeScript types, JSON schemas, validators, and CLI tools for the K-12 OCX specification.",
  "license": "Apache-2.0",
  "author": "Learning Tapestry",
  "contributors": [
    "Rômulo Saksida <romulo@rsaksida.com>"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ocx-validate": "./dist/bin/ocx-validate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.dist.json && cp src/*{.d.ts,.schema.json} dist/ && mkdir -p dist/formats && cp src/formats/*.schema.json src/formats/*.d.ts dist/formats/ && chmod +x ./dist/bin/ocx-validate.js",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:all && npm run clean && npm run build && npm run smoke:pack",
    "smoke:pack": "node scripts/smokePack.js",
    "test": "vitest run --exclude test/bin/**",
    "test:bin": "vitest run test/bin",
    "test:all": "vitest run",
    "fixtures:rebuild": "cd test/fixtures/package && for dir in *-package; do name=${dir%-package}; rm -f \"$name.ocx.zip\" && (cd \"$dir\" && zip -r \"../$name.ocx.zip\" .); done",
    "typecheck": "tsc",
    "generate-json-schema": "tsx scripts/generateSchema.ts ontology/entities.json ontology/value_standards.json src/",
    "generate-arktype": "tsx scripts/generateArkTypes.ts ontology/entities.json ontology/value_standards.json src/validation/ark.ts",
    "generate-schema": "npm run generate-json-schema && npm run generate-arktype"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts"
    },
    "./manifest.schema.json": "./dist/manifest.schema.json",
    "./ocx": {
      "types": "./dist/ocx.d.ts"
    },
    "./ocx.schema.json": "./dist/ocx.schema.json",
    "./validation/ajv": {
      "types": "./dist/validation/ajv.d.ts",
      "import": "./dist/validation/ajv.js",
      "default": "./dist/validation/ajv.js"
    },
    "./validation/ark": {
      "types": "./dist/validation/ark.d.ts",
      "import": "./dist/validation/ark.js",
      "default": "./dist/validation/ark.js"
    },
    "./validation/manifest-ajv": {
      "types": "./dist/validation/manifest-ajv.d.ts",
      "import": "./dist/validation/manifest-ajv.js",
      "default": "./dist/validation/manifest-ajv.js"
    },
    "./validation/package": {
      "types": "./dist/validation/package.d.ts",
      "import": "./dist/validation/package.js",
      "default": "./dist/validation/package.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "import": "./dist/formats/index.js",
      "default": "./dist/formats/index.js"
    },
    "./formats/lmsActivity": {
      "types": "./dist/formats/lmsActivity.d.ts"
    },
    "./formats/lmsActivity-ajv": {
      "types": "./dist/formats/lmsActivity-ajv.d.ts",
      "import": "./dist/formats/lmsActivity-ajv.js",
      "default": "./dist/formats/lmsActivity-ajv.js"
    },
    "./formats/lmsActivity-ark": {
      "types": "./dist/formats/lmsActivity-ark.d.ts",
      "import": "./dist/formats/lmsActivity-ark.js",
      "default": "./dist/formats/lmsActivity-ark.js"
    },
    "./formats/lmsActivity.schema.json": "./dist/formats/lmsActivity.schema.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learningtapestry/ocx-spec.git",
    "directory": "ocx-tools"
  },
  "bugs": {
    "url": "https://github.com/learningtapestry/ocx-spec/issues"
  },
  "homepage": "https://github.com/learningtapestry/ocx-spec/tree/main/ocx-tools",
  "dependencies": {
    "@zip.js/zip.js": "^2.7.54",
    "ajv": "^8.17.1",
    "arkregex": "^0.0.5",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.0",
    "arktype": "^2.1.29",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "arktype": "^2.1.28"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    }
  }
}
